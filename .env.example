# Copy this file to .env.local and fill in your project's browser-safe values.
# Never put service_role or secret keys in VITE_* variables.
# Keep .env.local uncommitted.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_BROWSER_SAFE_KEY

# Matchmaking photo experiences stay off until explicitly enabled.
VITE_MATCHMAKING_PHOTOS_UI=false
VITE_MATCHMAKING_PHOTOS_DISCOVERY=false

# Marriage Support and Coaching intake stay off until their migration is deployed and accepted.
VITE_MARRIAGE_SUPPORT_INTAKE=false
VITE_COACHING_INTAKE=false
