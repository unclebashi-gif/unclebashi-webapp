# Copy to .env.test and use dedicated disposable accounts only.
# Never use production account passwords or commit .env.test.
TEST_BASE_URL=http://localhost:8080
TEST_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
TEST_SUPABASE_ANON_KEY=YOUR_BROWSER_SAFE_KEY
TEST_MATCHMAKING_OWNER_EMAIL=disposable-owner@example.test
TEST_MATCHMAKING_OWNER_PASSWORD=FILL_LOCALLY
TEST_MATCHMAKING_OTHER_EMAIL=disposable-eligible-member@example.test
TEST_MATCHMAKING_OTHER_PASSWORD=FILL_LOCALLY
TEST_ADMIN_EMAIL=disposable-admin@example.test
TEST_ADMIN_PASSWORD=FILL_LOCALLY
TEST_MATCHMAKING_PHOTOS_ALLOW_MUTATIONS=false

# Dedicated non-production accounts for Wave 5. The support account must have
# active, eligible marriage_support and coaching journeys before the run.
TEST_SUPPORT_USER_EMAIL=disposable-support-user@example.test
TEST_SUPPORT_USER_PASSWORD=FILL_LOCALLY
TEST_SUPPORT_OTHER_EMAIL=disposable-other-user@example.test
TEST_SUPPORT_OTHER_PASSWORD=FILL_LOCALLY
TEST_SUPPORT_COACHING_ALLOW_MUTATIONS=false

# Dedicated ordinary users and an admin/moderator for Wave 6 lifecycle and queue tests.
TEST_COUNSELLING_USER_EMAIL=disposable-counselling-user@example.test
TEST_COUNSELLING_USER_PASSWORD=FILL_LOCALLY
TEST_COUNSELLING_OTHER_EMAIL=disposable-counselling-other@example.test
TEST_COUNSELLING_OTHER_PASSWORD=FILL_LOCALLY
TEST_COUNSELLING_ADMIN_EMAIL=disposable-counselling-admin@example.test
TEST_COUNSELLING_ADMIN_PASSWORD=FILL_LOCALLY
TEST_COUNSELLING_GATEWAY_ALLOW_MUTATIONS=false
# Optional browser routes: ON must be built with VITE_COUNSELLING_GATEWAY=true; OFF with it unset/false.
TEST_COUNSELLING_GATEWAY_UI_URL=
TEST_COUNSELLING_GATEWAY_OFF_URL=

# Optional read-only Wave 7 Auth/RPC check. Use two dedicated non-production accounts.
# TEST_TRUST_VERIFICATION_ALLOW_AUTH=true is required before this runner will sign in.
TEST_TRUST_VERIFICATION_ALLOW_AUTH=false
TEST_TRUST_VERIFICATION_VERIFIED_EMAIL=disposable-verified@example.test
TEST_TRUST_VERIFICATION_VERIFIED_PASSWORD=FILL_LOCALLY
TEST_TRUST_VERIFICATION_UNVERIFIED_EMAIL=disposable-unverified@example.test
TEST_TRUST_VERIFICATION_UNVERIFIED_PASSWORD=FILL_LOCALLY

# Optional trusted read-only database contract check only. Do not use this in
# the browser acceptance harness; the suite itself never needs a DB password.
# TEST_DATABASE_URL=postgresql://READ_ONLY_USER:LOCAL_PASSWORD@HOST:5432/DATABASE
