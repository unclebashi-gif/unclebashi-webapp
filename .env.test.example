# Copy to .env.test and use dedicated disposable accounts only.
# Never use production account passwords or commit .env.test.
TEST_BASE_URL=http://localhost:8080
TEST_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
TEST_SUPABASE_ANON_KEY=YOUR_BROWSER_SAFE_KEY
TEST_MATCHMAKING_OWNER_EMAIL=disposable-owner@example.test
TEST_MATCHMAKING_OWNER_PASSWORD=FILL_LOCALLY
TEST_MATCHMAKING_OTHER_EMAIL=disposable-eligible-member@example.test
TEST_MATCHMAKING_OTHER_PASSWORD=FILL_LOCALLY
TEST_ADMIN_EMAIL=disposable-admin@example.test
TEST_ADMIN_PASSWORD=FILL_LOCALLY
TEST_MATCHMAKING_PHOTOS_ALLOW_MUTATIONS=false

# Optional trusted read-only database contract check only. Do not use this in
# the browser acceptance harness; the suite itself never needs a DB password.
# TEST_DATABASE_URL=postgresql://READ_ONLY_USER:LOCAL_PASSWORD@HOST:5432/DATABASE
